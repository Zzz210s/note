{
  // 0-Note 的 markdownlint 规则集(2026-09-23 定)。
  // 原则:只关掉"与库内既有写法约定冲突、且改起来只会让正文更难读"的规则;
  // 其余全部保持默认开启,让 VS Code 的 markdownlint 扩展继续当校对。
  "MD013": false, // 行宽:中文长句与表格天然超 80 列,库内约定不折行(README 已有说明)
  "MD060": false, // 表格列风格:中文宽度下手对齐,机器判"不一致"无意义(4492 条噪音全在此)
  "MD036": false, // 用 **加粗** 当小标题:中文笔记惯例(尤其每日笔记里的例句编号)
  "MD024": { "siblings_only": true }, // 允许不同小节出现同名标题(如各单元的「语法」「每日进度」)
  "MD033": { "allowed_elements": ["kbd", "u", "sub"] } // kbd(按键)、u(下划线)、sub(下标)是语义化内联标签,库内用它表达真实语义
}
